# Binance API credentials. Copy this file to .env and fill it in.
# Never commit .env. Never paste keys into chats, issues, or logs.
#
# Key permissions required: Enable Reading, Spot & Margin Trading, Futures,
# Universal Transfer. Withdrawals must stay DISABLED. IP access restriction must be ON.

BINANCE_API_KEY=

# Option A (recommended): Ed25519 key pair. Generate it with `uv run mb keygen`,
# register the public key on Binance, and point this to the private key file.
BINANCE_PRIVATE_KEY_PATH=secrets/binance_ed25519_private.pem
BINANCE_PRIVATE_KEY_PASSPHRASE=

# Option B: HMAC key. Leave empty when using Ed25519.
BINANCE_API_SECRET=

# Binance Demo Trading (paper trading for drills: `mb --env demo ...`).
# Create the key on the Demo Trading API management page; it is separate from the live key.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
BINANCE_DEMO_PRIVATE_KEY_PATH=
